# -------------------------------------------------------------------
# Angel One SmartAPI credentials.
# Copy this file to `.env` and fill it in. NEVER commit `.env`.
# Get these from https://smartapi.angelbroking.com/ (create an API app).
# -------------------------------------------------------------------

# The API key of the SmartAPI app you created ("Market feeds" / "Trading" app).
ANGEL_API_KEY=

# Your Angel One login / client code (e.g. A123456).
ANGEL_CLIENT_CODE=

# Your Angel One login PIN (the numeric MPIN you use to log in).
ANGEL_PIN=

# The TOTP *secret* (base32 string) shown when you enable TOTP on your
# Angel One account. NOT the 6-digit code — the secret it was generated from.
# The app derives the live 6-digit code from this each login.
ANGEL_TOTP_SECRET=
